---
import { render } from 'astro:content';
import BaseLayout from '~/layouts/BaseLayout.astro';
import NovelReader from '~/components/NovelReader.astro';
import { URLS } from '~/constants';
import { getAllSeries, getAdjacent } from '~/lib/novel';

export async function getStaticPaths() {
  const all = await getAllSeries();

  return all.flatMap((series) =>
    series.chapters.map((chapter) => ({
      params: { slug: series.slug, chapter: String(chapter.number) },
      props: { series, chapter },
    })),
  );
}

const { series, chapter } = Astro.props;
const { Content } = await render(chapter.entry);
const { prev, next } = getAdjacent(series.chapters, chapter.number);

const custom = chapter.entry.data.chapterTitle;
const heading = custom
  ? `Chapter ${chapter.number}: ${custom}`
  : `Chapter ${chapter.number}`;
---

<BaseLayout
  title={`${series.title} — ${heading}`}
  description={`Baca ${series.title} ${heading} bahasa Indonesia.`}
  noindex={true}
  minimal={true}
>
  <NovelReader
    seriesSlug={series.slug}
    chapterNumber={chapter.number}
    novelTitle={series.title}
    chapterHeading={heading}
    tocUrl={URLS.novel(series.slug)}
    prevUrl={prev ? URLS.novelChapter(series.slug, prev.number) : undefined}
    nextUrl={next ? URLS.novelChapter(series.slug, next.number) : undefined}
  >
    <Content />
  </NovelReader>
</BaseLayout>