---
import { render } from 'astro:content';
import { getAllSeries, getAdjacent } from '~/lib/novel';

export async function getStaticPaths() {
  const all = await getAllSeries();
  return all.flatMap((series) =>
    series.chapters.map((chapter) => ({
      params: { slug: series.slug, chapter: String(chapter.number) },
      props: { series, chapter },
    })),
  );
}

const { series, chapter } = Astro.props;
const { Content } = await render(chapter.entry);
const { prev, next } = getAdjacent(series.chapters, chapter.number);
---

<BaseLayout
  title={`${series.title} — ${chapter.title}`}
  description={`Baca ${series.title} ${chapter.title} subtitle Indonesia.`}
  noindex={true}
>
  <NovelReader
    novelTitle={series.title}
    chapterTitle={chapter.title}
    prevUrl={prev ? URLS.novelChapter(series.slug, prev.number) : undefined}
    nextUrl={next ? URLS.novelChapter(series.slug, next.number) : undefined}
    tocUrl={URLS.novel(series.slug)}
  >
    <Content />
  </NovelReader>
</BaseLayout>